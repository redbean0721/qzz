NODE_ENV=development
PORT=3001
HOST=0.0.0.0

DATABASE_URL=postgres://qzz:qzz@127.0.0.1:5432/qzz
REDIS_URL=redis://127.0.0.1:6379

# Public origin of the site (the Nuxt app). Short links, paste pages and raw URLs are built on it;
# /v1/* on this origin is routed to the API (Cloudflare route in prod, Nuxt dev proxy in dev).
PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted (the in-cluster hop in front of the API).
# Leave empty in dev; never set to "true".
TRUST_PROXY=

# Per-IP requests per minute (defaults shown)
# RATE_LIMIT_CREATE_LINK=10
# RATE_LIMIT_CREATE_PASTE=5
# RATE_LIMIT_DELETE=20
# RATE_LIMIT_REPORT=5
# RATE_LIMIT_OG_IMAGE=60
# RATE_LIMIT_LINK_PREVIEW=30

# Google Safe Browsing API key (optional). When set, new short links whose target Google flags
# (phishing, malware, ...) are rejected; if Google is unreachable the link is allowed.
# SAFE_BROWSING_API_KEY=

# How often expired links/pastes are deleted (default 60)
# CLEANUP_INTERVAL_MINUTES=60
