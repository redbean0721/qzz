NODE_ENV=development
PORT=3001
HOST=0.0.0.0

DATABASE_URL=postgres://qzz:qzz@127.0.0.1:5432/qzz
REDIS_URL=redis://127.0.0.1:6379

PUBLIC_BASE_URL=http://localhost:3001

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted (e.g. Caddy).
# Leave empty in dev; never set to "true".
TRUST_PROXY=

# Per-IP requests per minute (defaults shown)
# RATE_LIMIT_CREATE_LINK=10
# RATE_LIMIT_CREATE_PASTE=5
# RATE_LIMIT_DELETE=20

# How often expired links/pastes are deleted (default 60)
# CLEANUP_INTERVAL_MINUTES=60
