{
  "name": "qzz",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "yarn workspace @qzz/web dev",
    "dev:api": "yarn workspace @qzz/api dev",
    "dev:ext": "yarn workspace @qzz/extension dev",
    "build:shared": "yarn workspace @qzz/shared build",
    "dev:shared": "yarn workspace @qzz/shared dev",
    "db:up": "docker compose -f deploy/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f deploy/docker-compose.dev.yml down",
    "db:logs": "docker compose -f deploy/docker-compose.dev.yml logs -f",
    "db:generate": "yarn workspace @qzz/api db:generate",
    "db:migrate": "yarn workspace @qzz/api db:migrate",
    "db:studio": "yarn workspace @qzz/api db:studio"
  }
}
